emaColor = input.color(color.orange, "EMA", group="4. Display", display=display.none)
compactLabels = input.bool(true, "Compact labels and spacing", group="4. Display", display=display.none, tooltip="Smaller titles and cell spacing only. Full formulas, values, timestamps and failure reasons remain in hover tooltips. Chart-provider bid/ask, price-axis labels and other scripts are not controlled by this setting.")

dashboardMode = input.string("Closed snapshot", "Dashboard evidence", options=["Closed snapshot", "Live preview"], group="4. Display", display=display.none, tooltip="Default: analytical rows explain the last closed chart event. Live preview changes detail rows only; ENTRY and RANGE remain closed. RANGE has its own labelled timeframe/lookback. Hover rows for timestamps and data diagnostics.")
momDisplayBasis = input.string("Active entry basis", "Displayed MOM basis", options=["Active entry basis", "Native price comparison"], group="4. Display", display=display.none, tooltip="Default displays the same gap-adjusted or original MOM values used by ENTRY. Native comparison is display-only and labelled NATIVE. Neither changes execution rules.")
momColorMode = input.string("Sign", "MOM colour meaning", options=["Sign", "Change"], group="4. Display", display=display.none)

