//@version=6
indicator("Simple Quant+ v3.7.2 | Readable own-TF signals", shorttitle="SQ+3.7.2 R", overlay=false, behind_chart=false, scale=scale.right, precision=4, max_lines_count=2, max_labels_count=60, max_bars_back=1000, dynamic_requests=true)

// v3.7.2: READABLE PANEL. Direction/episode/alert/plan calculations unchanged.
// Trend -> Entry (status + no-chase; timestamp in tooltip only) -> SL/Exit -> primary indicators.
// Whole-table default font: Small. Auto-sized cells expand with the selected font.
// 20-session 15m SPY/QQQ markout comparison: mixed, NOT a proven trading edge.
// Breakout remains reference, no-chase warning, Delta context. Optional gates
// remain explicit. No universal improvement or full-month Delta test claimed.
// RELEASE STATUS: source + Python regression reviewed; native Pine compilation
// and provider-specific live/reload parity are NOT certified.
// Default: own-TF DI/ADX + MOM3/MOM6 + EMA side produce direction.
// Previous-bar breakout is reference; no-chase is a visible risk warning.
// Both remain selectable universal signal filters, but are not secretly required.
// Local DI/ADX is required by default; estimated Delta is REFERENCE. Optional
// modes are UNIVERSAL, labelled, and fail closed on missing required evidence.
// No data-derived "optimal" threshold or profitability claim is made.
// Episodes re-arm only after structural MOM+EMA reset, not a failed breakout.
// Last qualification, live freshness and alert issuance are separate states.
// Recovery notifications need a NEW fresh qualifying close in a live episode.
// Historical attachment never creates a pending recovery notification.
// Overall Trend is REFERENCE ONLY: <=15m ->15m; above15m ->chart TF.
// Signals: closed native OHLC -> own DI/ADX -> MOM3/prior ATR ->
// cumulative MOM6 -> EMA side -> selected optional gates -> structural episode.
// Default Delta policy is CONTEXT ONLY FOR EVERY SYMBOL. Optional required
// Delta1 / Delta1+DeltaN uses native estimated flow and FAILS CLOSED when absent.
// No index-specific entry rule, proxy volume, separate label path, or index alert.
// One identical L/S plotshape pair and one direction-event alert path.
// Direction signals are NOT risk-qualified plans, orders, option contracts or fills.
// Optional legacy price guides remain a SEPARATE, instrument-aware module.
// Guide quotas/size/expiry/manual position NEVER veto the direction markers.
// Default MOM dashboard now shows the ACTIVE entry basis, explicitly tagged G.
// Native-price MOM remains an optional DISPLAY-only comparison.
// Missing native bars are not filled; shortened native candles cannot open signals.
// No future HTF values or negative marker offset. Snapshot timestamps retained.
// Trade/account risk, live execution and actual broker positions are NOT automated.
// Native TradingView compile/replay/notification parity must still be verified.
// This revision is a rules/architecture correction, NOT a proven return optimum.

// ── 1. Decision architecture ───────────────────────────────────────────────
momLen = input.int(3, "Setup MOM block: bars", minval=1, maxval=50, group="1. Decision", display=display.none, tooltip="Current setup block = close - close[momLen]. Optional previous-block confirmation uses the preceding non-overlapping block: close[momLen] - close[2*momLen]. The separate confirmation selector can change that rule.")
showSecondMOM = input.bool(true, "Show cumulative MOM context (2 x block)", group="1. Decision", display=display.none, tooltip="Displays true cumulative MOM6 (close - close[6] at the default MOM3 setting). The preceding non-overlapping block is retained in the tooltip; it appears alongside cumulative MOM only when that different confirmation mode is selected.")
momMoveAtrFrac = input.float(0.02, "MOM wording deadband: ATR fraction", minval=0.0, maxval=0.50, step=0.01, group="1. Decision", display=display.none, tooltip="Arrow/wording deadband only. Default MOM colors describe positive/negative sign; the optional Change color mode describes strengthening/fading. Neither color is a CALL/PUT instruction.")
emaLen = input.int(20, "EMA length", minval=1, maxval=200, group="1. Decision", display=display.none)
showHistogram = input.bool(false, "Optional MOM histogram", group="1. Decision", display=display.none)

string signalTF = timeframe.main_period // SINGLE source of truth: user-selected chart TF.
trendMode = input.string("Auto from chart", "REFERENCE Trend timeframe", options=["Auto from chart", "Manual"], group="1. Decision", display=display.none, tooltip="Reference only, never an entry/exit/plan veto. Auto: 5m->15m, 15m->15m, 30m->30m, 1h->1h. L/S always uses the native chart timeframe.")
manualTrendTF = input.timeframe("15", "Manual Overall Trend TF", options=["1", "3", "5", "15", "30", "60", "120", "240", "1D", "1W", "1M"], group="1. Decision", display=display.none)
reversalConfirmBars = input.int(1, "Opposite signal: qualifying closed bars", minval=1, maxval=3, group="1. Decision", display=display.none, tooltip="Default one completed own-TF qualification. Two or three require consecutive complete qualifications and deliberately delay reversals. Not optimized on returns.")
momentumSessionMode = input.string("Auto: strict through 15m", "Original-MOM / Delta session policy", options=["Auto: strict through 15m", "Continuous chart bars", "Same session only"], group="1. Decision", display=display.none, tooltip="Original basis: Auto requires same-session MOM history through 15m. Gap-neutral basis instead keeps full 3/6-bar chart history, removing observed opening gaps. Delta rolling windows retain their selected session policy. Active displayed MOM follows ENTRY. Native-price comparison is display-only.")

momAtrMin = input.float(0.10, "Minimum |MOM| / prior ATR", minval=0.0, maxval=2.0, step=0.01, group="1. Decision", display=display.none, tooltip="Normalized setup threshold. Research input, not a certified optimum.")
deltaPctMin = input.float(0.08, "Minimum |estimated Delta| / bar volume", minval=0.0, maxval=1.0, step=0.01, group="1. Decision", display=display.none, tooltip="Participation threshold. Research input, not a certified optimum.")
adxEnter = input.float(20.0, "Trend ADX enter", minval=1.0, maxval=100.0, step=0.5, group="1. Decision", display=display.none)
adxExit = input.float(17.0, "Trend ADX exit", minval=1.0, maxval=100.0, step=0.5, group="1. Decision", display=display.none)
diSpreadMin = input.float(0.08, "Minimum normalized DI spread", minval=0.0, maxval=1.0, step=0.01, group="1. Decision", display=display.none)
maxEmaDistanceAtr = input.float(1.25, "No-chase distance from trigger EMA: ATR", minval=0.1, maxval=5.0, step=0.05, group="1. Decision", display=display.none)
confirmationMode = input.string("Cumulative MOM", "Decision momentum confirmation", options=["Previous block (baseline)", "Cumulative MOM", "Off"], group="1. Decision", display=display.none, tooltip="Default: MOM3 and cumulative MOM6 must have the same sign. Previous block is a stricter, DIFFERENT test: close[3]-close[6]. All calculations use the selected active price basis and own chart TF.")
trendPriceMode = input.string("DMI / ADX baseline", "Overall Trend price coherence", options=["DMI / ADX baseline", "Require EMA side + slope (research)"], group="1. Decision", display=display.none, tooltip="Baseline retains v2.9.0. Research mode also requires the completed trend close and EMA slope to agree with DI direction. Not a tested superior setting.")
entryPriceMode = input.string("Signal agreement (baseline)", "Universal entry price trigger", options=["Signal agreement (baseline)", "Break previous chart bar (research)"], group="1. Decision", display=display.none, tooltip="Default displays previous-bar breakout as REFERENCE, not a mandatory directional-label delay. Selecting Break previous chart bar requires a completed own-TF close above the prior high for L, below prior low for S, with adjacent same-session bars. Same rule for every symbol.")
noChasePolicy = input.string("Warning only", "No-chase role in directional signals", options=["Warning only", "Required filter"], group="1. Decision", display=display.none, tooltip="Warning only: L/S and ENTRY describe direction even when extended; ENTRY and alerts explicitly say EXTENDED / NO CHASE. This is NOT permission to enter. Optional price-plan limits still enforce their frozen no-chase cap. Required filter restores the old label veto at 1.25 prior ATR. Universal for every symbol.")
bool requireNoChase = noChasePolicy == "Required filter"
requireEMASide = input.bool(true, "Require own-TF EMA side (FILTER)", group="1. Decision", display=display.none, tooltip="L requires close above the active own-TF EMA; S below. Overall Trend is not consulted.")



ownDmiPolicy = input.string("Require DI + ADX", "Own-TF DI / ADX confirmation", options=["Reference only", "Require DI", "Require DI + ADX"], group="1. Decision", display=display.none, tooltip="Release default uses OWN-TF DI + ADX to define a confirmed direction, not a profitable entry. Breakout and no-chase are not simultaneously forced on directional labels. The limited sample does not establish optimality. Required DI compares normalized (+DI - -DI)/(+DI + -DI). Required ADX uses own-TF enter/hold hysteresis; an ADX rising arrow is NEVER an additional condition. No reference Trend value is consulted.")
ownDiSpreadMin = input.float(0.08, "Own-TF minimum normalized DI spread", minval=0.0, maxval=1.0, step=0.01, group="1. Decision", display=display.none)
ownAdxEnter = input.float(20.0, "Own-TF ADX enter (optional filter)", minval=1, maxval=100, step=0.5, group="1. Decision", display=display.none)
ownAdxExit = input.float(17.0, "Own-TF ADX hold (optional filter)", minval=1, maxval=100, step=0.5, group="1. Decision", display=display.none)
showManualExitMarkers = input.bool(true, "Show manual-position EXIT markers", group="7. Manual position", display=display.none)
alertGraceSeconds = input.int(90, "Fresh closed-event alert grace: seconds", minval=1, maxval=300, group="5. Alerts", display=display.none)
recoveryAlerts = input.bool(true, "Recover unissued live episode on next fresh qualification", group="5. Alerts", display=display.none, tooltip="A late original close can arm recovery, but only a later fresh fully qualifying close can issue it, using that later close and labelled RECOVERY. No historical-attachment replay, old price resend, or delivery acknowledgement.")

// Operational default: REFERENCE Trend + gap-neutral MOM/EMA. Not optimized.
entryBasis = input.string("Gap-neutral MOM + EMA", "Entry price/momentum basis", options=["Original", "Gap-neutral MOM", "Gap-neutral MOM + EMA"], group="1. Decision", display=display.none, tooltip="Original retains same-session entry warmup. Gap-neutral MOM uses the full 3/6-bar history with observed opening gaps subtracted, and therefore may include earlier-session INTRADAY moves but not their opening jumps. The EMA variant also translates the smoothed gap-neutral price back to current price units for the no-chase test. Prior ATR is retained; Delta follows the universal policy. Overall Trend is reference-only. Optional risk plans remain separate. The default Gap-neutral MOM + EMA is adopted for intraday session behavior, NOT selected by a completed market backtest. On non-intraday charts Original is used.")
showDirectionMarkers = input.bool(true, "Show universal L / S direction markers", group="4. Display", display=display.none, tooltip="One marker on each new qualified direction episode. The same shape, size and meaning apply to every symbol. Price-plan checks do not suppress these markers.")

// ── 2. Volume context ───────────────────────────────────────────────────────
sessionZone = input.string("America/New_York", "Display time zone", options=["America/New_York", "America/Chicago", "Europe/London", "Etc/UTC", "Exchange"], group="2. Volume", display=display.none, tooltip="Display formatting only. Calculation sessions always follow the active TradingView chart session: RTH, extended, 24h or the selected provider-defined subsession.")
flowEstimator = input.string("Range-weighted", "Estimated Delta method", options=["Range-weighted", "Whole-bar sign (legacy)"], group="2. Volume", display=display.none, tooltip="Range-weighted uses V*(close-open)/(high-low), clipped to +/-V. Legacy assigns the whole 1m volume to one sign. Neither is bid/ask aggressor flow.")
rvolMode = input.string("Chart bar", "RVOL interval", options=["Chart bar", "Session cumulative"], group="2. Volume", display=display.none)
rvolDays = input.int(20, "RVOL prior sessions", minval=5, maxval=30, group="2. Volume", display=display.none)
minSamples = input.int(10, "RVOL minimum samples", minval=3, maxval=30, group="2. Volume", display=display.none)
showFlow = input.bool(true, "Show estimated Delta1 / Delta3 row", group="2. Volume", display=display.none, tooltip="Delta1 = latest selected chart candle; Delta3 = sum of the latest three by default. The second label follows the context-bars input. Session CVD is not shown. This display toggle does not change the universal Delta policy.")
deltaContextBars = input.int(3, "Estimated Delta window bars (default 3)", minval=2, maxval=100, group="2. Volume", display=display.none, tooltip="N selected-chart candles: 5m x3, 15m x3, etc. DeltaN% is summed estimated signed volume divided by summed source volume. Context by default; required only under universal Require Delta1 + DeltaN. Missing component coverage restarts warmup. A fully covered shortened candle may be displayed, but cannot start a full-TF direction event.")
bool volumeAllowed = true // A missing/zero vendor volume stays N/A; never an entry veto in Context only.
bool flowAllowed = true // Native chart symbol only. No index-specific source or proxy.
flowPolicy = input.string("Context only", "Universal estimated Delta policy", options=["Context only", "Require Delta1", "Require Delta1 + DeltaN"], group="1. Decision", display=display.none, tooltip="Same policy for EVERY symbol. Context only never gates a signal on volume availability/sign. Required modes need verified native one-minute source coverage; missing flow means WAIT, never a symbol-specific bypass. Delta is a candle-based estimate, not bid/ask aggressor flow.")
bool requireFlow = flowPolicy != "Context only"
bool requireRollingFlow = flowPolicy == "Require Delta1 + DeltaN"
signalAlerts = input.bool(true, "Enable universal direction notifications", group="5. Alerts", display=display.none, tooltip="Also enable the master notification switch and create a TradingView alert. Notification only, not a price-plan/order/fill.")

// ── 3. Range, pivots and structure ─────────────────────────────────────────
