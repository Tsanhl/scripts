f_trend_packet_full(simple int expectedMs, simple bool intradayBasis) =>
    [pdi, mdi, ax] = ta.dmi(diLen, adxSmooth)
    float e = ta.ema(close, emaLen)
    float spread = not na(pdi) and not na(mdi) and pdi + mdi > 0 ? (pdi - mdi) / (pdi + mdi) : na
    bool newSession = intradayBasis and not na(time_tradingday[1]) and time_tradingday != time_tradingday[1]
    bool fullDuration = not intradayBasis or (not na(time_close) and time_close - time == expectedMs)
    var bool strengthActive = false
    if newSession
        strengthActive := false
    if fullDuration
        strengthActive := not na(ax) and (strengthActive ? ax >= adxExit : ax >= adxEnter)
    int side = na(spread) ? 0 : spread > 0 ? 1 : spread < 0 ? -1 : 0
    int regime = strengthActive and not na(spread) and math.abs(spread) >= diSpreadMin ? side : 0
    bool trendPriceAligned = not na(e[1]) and side * (close - e) > 0 and side * (e - e[1]) > 0
    if trendPriceMode != "DMI / ADX baseline" and not trendPriceAligned
        regime := 0
    var TrendSnapshot latestFull = na
    if fullDuration
        latestFull := TrendSnapshot.new(regime, pdi, mdi, ax, ax[1], spread, e, e[1], close, time, time_close, time_tradingday)
    latestFull

f_trend_packet_confirmed(simple int expectedMs, simple bool intradayBasis) =>
    TrendSnapshot full = f_trend_packet_full(expectedMs, intradayBasis)
    full[1]

// RANGE maintains only actual complete source candles. A shortened session-end
// candle cannot collapse a multi-candle range to its own tiny span. Zero-span
// FULL candles remain valid. N counts actual available source candles; a gap is
// disclosed, not filled with made-up bars. Invalid OHLC clears the usable window.
// checkedAt is the evaluated SOURCE candle close, including invalid/partial bars.
// Window endAt alone cannot certify when the packet's state became knowable.
type RangeSnapshot
    float lowValue
    float highValue
    int beginAt
    int endAt
    int count
    int firstSession
    int lastSession
    int spanMs
    int checkedAt
    string state

f_range_packet_full(simple int expectedMs, simple bool intradayBasis) =>
    var array<float> lows = array.new<float>(0)
    var array<float> highs = array.new<float>(0)
    var array<int> starts = array.new<int>(0)
    var array<int> ends = array.new<int>(0)
    var array<int> sessionIds = array.new<int>(0)
    bool sessionChanged = intradayBasis and not na(time_tradingday[1]) and time_tradingday != time_tradingday[1]
    bool pricesOK = not na(open) and not na(high) and not na(low) and not na(close) and high >= math.max(open, close) and low <= math.min(open, close) and high >= low
    bool positiveDuration = not na(time) and not na(time_close) and time_close > time
    bool fullDuration = positiveDuration and (not intradayBasis or time_close - time == expectedMs)
    bool partialDuration = positiveDuration and intradayBasis and time_close - time < expectedMs
    bool invalidSource = not pricesOK or (not fullDuration and not partialDuration)
    if (rangeSessionMode == "Same session only" and sessionChanged) or invalidSource
        array.clear(lows)
        array.clear(highs)
        array.clear(starts)
        array.clear(ends)
        array.clear(sessionIds)
    if fullDuration and pricesOK
        array.push(lows, low)
        array.push(highs, high)
        array.push(starts, time)
        array.push(ends, time_close)
        array.push(sessionIds, time_tradingday)
        if array.size(lows) > rangeLookback
            array.shift(lows)
            array.shift(highs)
            array.shift(starts)
            array.shift(ends)
            array.shift(sessionIds)
    int n = array.size(lows)
    int firstAt = n > 0 ? array.get(starts, 0) : na
    int lastAt = n > 0 ? array.get(ends, n - 1) : na
    float rangeLow = n > 0 ? array.min(lows) : na
    float rangeHigh = n > 0 ? array.max(highs) : na
    int firstSid = n > 0 ? array.get(sessionIds, 0) : na
    int lastSid = n > 0 ? array.get(sessionIds, n - 1) : na
    string state = invalidSource ? (not pricesOK ? "INVALID SOURCE OHLC" : "INVALID SOURCE TIME") : partialDuration ? "PARTIAL SOURCE BAR SKIPPED" : n < rangeLookback ? "WARMUP" : "OK"
    // Always return a packet, including an EMPTY invalid packet. Otherwise a
    // gaps_off request / prior fallback could revive the old pre-error envelope.
    RangeSnapshot.new(rangeLow, rangeHigh, firstAt, lastAt, n, firstSid, lastSid, n > 0 ? lastAt - firstAt : na, time_close, state)

f_range_packet_confirmed(simple int expectedMs, simple bool intradayBasis) =>
    RangeSnapshot packet = f_range_packet_full(expectedMs, intradayBasis)
    packet[1]

// A missing native bar must not silently compress a 3/6-bar entry window.
// Actual selected-session boundaries are allowed; arbitrary intraday gaps are not.
f_mom_clock_ok(int bars) =>
    bool ok = not na(close[bars]) and priceEpoch == priceEpoch[bars]
    if chartIntraday
        for i = 0 to bars - 1
            bool endpoints = not na(close[i]) and not na(close[i + 1]) and not na(time[i]) and not na(time_close[i + 1])
            bool sameSession = not na(time_tradingday[i]) and time_tradingday[i] == time_tradingday[i + 1]
            bool joined = sameSession ? time[i] == time_close[i + 1] : verifiedSessionBridge[i]
            if not endpoints or not joined
                ok := false
    ok
bool momClock3OK = f_mom_clock_ok(momLen)
bool momClock6OK = f_mom_clock_ok(momContextLen)

f_core(simple string basisTF, simple bool enforceSessionWindows) =>
    float basisSeconds = timeframe.in_seconds(basisTF)
    bool supported = chartSupported and not na(basisSeconds) and basisSeconds >= 60 and basisSeconds <= 86400
    int feedOpen = na
    int feedEnd = na
    if supported
        [clockOpen, clockEnd] = request.security(chartSessionTicker, "1", [time, time_close], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true, calc_bars_count=50000)
        feedOpen := clockOpen
        feedEnd := clockEnd
    bool clockInParent = f_minute_in_parent(feedOpen, feedEnd, time, time_close)
    int sessionId = time_tradingday
    bool inside = not na(sessionId)
    bool priceBarOK = not na(time_close) and time_close > time and not na(open) and not na(high) and not na(low) and not na(close) and high >= math.max(open, close) and low <= math.min(open, close) and high >= low

    bool currentBlockSameSession = useGapMOM or not enforceSessionWindows or (not na(sessionId[momLen]) and sessionId == sessionId[momLen])
    bool priorBlockSameSession = useGapMOM or not enforceSessionWindows or (not na(sessionId[momContextLen]) and sessionId == sessionId[momLen] and sessionId == sessionId[momContextLen])
    float momentumPrice = useGapMOM ? gapNeutralPrice : close
    float m = currentBlockSameSession and momClock3OK ? momentumPrice - momentumPrice[momLen] : na
    float priorBlock = priorBlockSameSession and momClock6OK ? momentumPrice[momLen] - momentumPrice[momContextLen] : na
    float nativeEMA = ta.ema(close, emaLen)
    float e = useGapEMA ? gapNeutralEMA : nativeEMA
    float atrBase = ta.atr(14)[1]
    float momNorm = not na(m) and not na(atrBase) and atrBase > 0 ? m / atrBase : na
    float emaDistanceAtr = not na(e) and not na(atrBase) and atrBase > 0 ? (close - e) / atrBase : na
    [pdi, mdi, ax] = ta.dmi(diLen, adxSmooth)
    bool mOK = not na(m) and not na(momNorm)
    bool priorOK = not na(priorBlock)

    float cv = na
    float dv = na
    float parentV = na
    float deltaPct = na
    float change = na
    float changePct = na
    int historyBars = 0
    int flowAsOf = na
    bool aligned = false
    string flowStatus = not supported ? "USE 1m-1D" : "NO SOURCE HISTORY"
    string deltaStatus = flowStatus
    string changeStatus = flowStatus
    if supported
        [fc, fd, fv, fs, fa, fp, fst, fdt, flowOpen, flowEnd] = request.security(flowTicker, "1", f_flow_packet(basisTF), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true, calc_bars_count=50000)
        bool timeOK = inside and fs == sessionId and fp == time and f_same_source_minute(flowOpen, flowEnd, fa, feedOpen, feedEnd, time, time_close)
        if timeOK
            cv := fc
            dv := fd
            parentV := fv
            deltaPct := not na(fv) and fv > 0 ? fd / fv : na
            flowAsOf := fa
            aligned := true
            flowStatus := fst
            deltaStatus := fdt
        else
            flowStatus := na(fs) ? "NO SOURCE HISTORY" : fs != sessionId ? "SESSION NOT ALIGNED" : fp != time ? "SOURCE INTERVAL NOT ALIGNED" : "SOURCE SYNC PENDING"
            deltaStatus := flowStatus

    var int cleanFlowBars = 0
    bool sameFlowSession = (not enforceSessionWindows or (not na(sessionId[1]) and sessionId == sessionId[1])) and (not chartIntraday or time == time_close[1] or verifiedSessionBridge)
    bool componentClosedOK = f_closed_window_ok(time, time_close, feedOpen, feedEnd, basisSeconds)
    bool cleanFlowBar = aligned and not na(dv) and not na(parentV) and parentV > 0 and (not barstate.isconfirmed or componentClosedOK)
    cleanFlowBars := cleanFlowBar ? (sameFlowSession ? nz(cleanFlowBars[1]) + 1 : 1) : 0
    historyBars := math.min(cleanFlowBars, deltaContextBars)
    bool changeWindowOK = cleanFlowBars >= deltaContextBars
    float rollingChange = 0.0
    float rollingVolume = 0.0
    if changeWindowOK
        for offset = 0 to deltaContextBars - 1
            float deltaPart = dv[offset]
            float volumePart = parentV[offset]
            bool sameWindowSession = not enforceSessionWindows or (not na(sessionId[offset]) and sessionId[offset] == sessionId)
            bool priorComponentComplete = offset == 0 ? (not barstate.isconfirmed or componentClosedOK) : componentClosedOK[offset]
            if na(deltaPart) or na(volumePart) or volumePart <= 0 or not sameWindowSession or not priorComponentComplete
                changeWindowOK := false
            else
                rollingChange += deltaPart
                rollingVolume += volumePart
    change := changeWindowOK ? rollingChange : na
    changePct := changeWindowOK and rollingVolume > 0 ? rollingChange / rollingVolume : na
    changeStatus := not aligned ? flowStatus : not cleanFlowBar ? deltaStatus : cleanFlowBars < deltaContextBars ? "Δ" + str.tostring(deltaContextBars) + " WARMUP " + str.tostring(cleanFlowBars) + "/" + str.tostring(deltaContextBars) : not changeWindowOK ? "DELTA WINDOW CHECK" : "OK"

    bool flowOK = aligned and not na(deltaPct) and (not requireRollingFlow or not na(changePct))
    bool ready = supported and inside and priceBarOK and mOK and not na(e) and not na(emaDistanceAtr) and (not requireFlow or flowOK)
    bool bull = ready and momNorm > 0 and momNorm >= momAtrMin and (not requireFlow or (deltaPct > 0 and deltaPct >= deltaPctMin and (not requireRollingFlow or changePct > 0)))
    bool bear = ready and momNorm < 0 and momNorm <= -momAtrMin and (not requireFlow or (deltaPct < 0 and deltaPct <= -deltaPctMin and (not requireRollingFlow or changePct < 0)))
    int direction = bull ? 1 : bear ? -1 : 0
    string why = bull or bear ? "OWN-TF MOM / SELECTED FLOW POLICY ALIGNED" : not supported ? "USE 1m-1D" : not priceBarOK ? "PRICE BAR CHECK" : not momClock3OK ? "MOM HISTORY CLOCK / PRICE CHECK" : not currentBlockSameSession ? "OPENING MOM WARMUP" : na(atrBase) or atrBase <= 0 ? "ATR WARMUP" : not mOK ? "MOM WARMUP" : na(e) or na(emaDistanceAtr) ? "EMA HISTORY / RESTART" : requireFlow and not flowOK ? "REQUIRED DELTA DATA WARMUP / MISSING" : momNorm == 0 ? "FLAT MOM" : math.abs(momNorm) < momAtrMin ? "MOM/ATR BELOW THRESHOLD" : requireFlow and requireRollingFlow and momNorm * changePct <= 0 ? "MOM / DELTAN CONFLICT" : requireFlow ? "MOM / DELTA1 SIGN OR THRESHOLD" : "THRESHOLDS NOT ALIGNED"
    [direction, ready, why, close, close[momLen], close[momContextLen], m, priorBlock, momNorm, e, atrBase, emaDistanceAtr, pdi, mdi, ax, m[1], priorBlock[1], ax[1], time, time_close, cv, dv, parentV, deltaPct, change, changePct, historyBars, flowAsOf, flowStatus, aligned, mOK, priorOK, sessionId, deltaStatus, changeStatus, feedOpen, feedEnd]

// ── Independent OVERALL TREND, source-time confirmed ────────────────────────
float trendSeconds = timeframe.in_seconds(trendTF)
int trendExpectedMs = int(trendSeconds * 1000.0)
bool trendIntraday = trendSeconds < 86400
bool trendIsLowerThanChart = hostSeconds > trendSeconds
TrendSnapshot trendPrior = request.security(chartSessionTicker, trendTF, f_trend_packet_confirmed(trendExpectedMs, trendIntraday), gaps=barmerge.gaps_off, lookahead=trendIsLowerThanChart ? barmerge.lookahead_off : barmerge.lookahead_on, ignore_invalid_symbol=true, calc_bars_count=5000)
TrendSnapshot trendRecent = request.security(chartSessionTicker, trendTF, f_trend_packet_full(trendExpectedMs, trendIntraday), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true, calc_bars_count=5000)
int trendCutoff = barstate.isconfirmed ? time_close : time
if trendIsLowerThanChart and not barstate.isconfirmed
    trendCutoff := request.security(chartSessionTicker, "1", time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true, calc_bars_count=50000)
bool priorClosed = not na(trendPrior) and not na(trendCutoff) and trendPrior.endAt <= trendCutoff
bool recentClosed = not na(trendRecent) and not na(trendCutoff) and trendRecent.endAt <= trendCutoff
TrendSnapshot chosenTrend = recentClosed and (not priorClosed or trendRecent.endAt >= trendPrior.endAt) ? trendRecent : priorClosed ? trendPrior : na

f_trend_status(TrendSnapshot t, int referenceSession, int referenceEnd) =>
    string result = "WARMUP"
    if not na(t)
        result := na(t.adxValue) or na(t.spread) or na(t.emaValue) ? "WARMUP" : na(referenceEnd) or t.endAt > referenceEnd ? "SOURCE TIME CHECK" : trendIntraday and t.endAt - t.beginAt != trendExpectedMs ? "PARTIAL BAR BLOCKED" : trendIntraday and t.sessionId != referenceSession ? "CURRENT SESSION WARMUP" : trendIntraday and referenceEnd - t.endAt >= trendExpectedMs ? "STALE TREND" : "OK"
    result

// ── Independent RANGE; no source end beyond this chart event's cutoff ──────
RangeSnapshot nativeRange = f_range_packet_full(rangeExpectedMs, rangeIntraday)
RangeSnapshot rangePrior = na
RangeSnapshot rangeRecent = na
if rangeTF == signalTF
    rangePrior := nativeRange[1]
    rangeRecent := nativeRange
else
    rangePrior := request.security(chartSessionTicker, rangeTF, f_range_packet_confirmed(rangeExpectedMs, rangeIntraday), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true, calc_bars_count=5000)
    rangeRecent := request.security(chartSessionTicker, rangeTF, f_range_packet_full(rangeExpectedMs, rangeIntraday), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true, calc_bars_count=5000)
int rangeCutoff = barstate.isconfirmed ? time_close : time
bool rangePriorClosed = not na(rangePrior) and not na(rangeCutoff) and not na(rangePrior.checkedAt) and rangePrior.checkedAt <= rangeCutoff
bool rangeRecentClosed = not na(rangeRecent) and not na(rangeCutoff) and not na(rangeRecent.checkedAt) and rangeRecent.checkedAt <= rangeCutoff
// Select by the packet's evaluation time, NOT its last usable candle's end.
// A newer empty/invalid packet must win over an older valid price envelope.
