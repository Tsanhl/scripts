// RANGE maintains only actual complete source candles. A shortened session-end
// candle cannot collapse a multi-candle range to its own tiny span. Zero-span
// FULL candles remain valid. N counts actual available source candles; a gap is
// disclosed, not filled with made-up bars. Invalid OHLC clears the usable window.
// checkedAt is the evaluated SOURCE candle close, including invalid/partial bars.
// Window endAt alone cannot certify when the packet's state became knowable.
type RangeSnapshot
    float lowValue
    float highValue
    int beginAt
    int endAt
    int count
    int firstSession
    int lastSession
    int spanMs
    int checkedAt
    string state

f_range_packet_full(simple int expectedMs, simple bool intradayBasis) =>
    var array<float> lows = array.new<float>(0)
    var array<float> highs = array.new<float>(0)
    var array<int> starts = array.new<int>(0)
    var array<int> ends = array.new<int>(0)
    var array<int> sessionIds = array.new<int>(0)
    bool sessionChanged = intradayBasis and not na(time_tradingday[1]) and time_tradingday != time_tradingday[1]
    bool pricesOK = not na(open) and not na(high) and not na(low) and not na(close) and high >= math.max(open, close) and low <= math.min(open, close) and high >= low
    bool positiveDuration = not na(time) and not na(time_close) and time_close > time
    bool fullDuration = positiveDuration and (not intradayBasis or time_close - time == expectedMs)
    bool partialDuration = positiveDuration and intradayBasis and time_close - time < expectedMs
    bool invalidSource = not pricesOK or (not fullDuration and not partialDuration)
    if (rangeSessionMode == "Same session only" and sessionChanged) or invalidSource
        array.clear(lows)
        array.clear(highs)
        array.clear(starts)
        array.clear(ends)
        array.clear(sessionIds)
    if fullDuration and pricesOK
        array.push(lows, low)
        array.push(highs, high)
        array.push(starts, time)
        array.push(ends, time_close)
        array.push(sessionIds, time_tradingday)
        if array.size(lows) > rangeLookback
            array.shift(lows)
            array.shift(highs)
            array.shift(starts)
            array.shift(ends)
            array.shift(sessionIds)
    int n = array.size(lows)
    int firstAt = n > 0 ? array.get(starts, 0) : na
    int lastAt = n > 0 ? array.get(ends, n - 1) : na
    float rangeLow = n > 0 ? array.min(lows) : na
    float rangeHigh = n > 0 ? array.max(highs) : na
    int firstSid = n > 0 ? array.get(sessionIds, 0) : na
    int lastSid = n > 0 ? array.get(sessionIds, n - 1) : na
    string state = invalidSource ? (not pricesOK ? "INVALID SOURCE OHLC" : "INVALID SOURCE TIME") : partialDuration ? "PARTIAL SOURCE BAR SKIPPED" : n < rangeLookback ? "WARMUP" : "OK"
    // Always return a packet, including an EMPTY invalid packet. Otherwise a
    // gaps_off request / prior fallback could revive the old pre-error envelope.
    RangeSnapshot.new(rangeLow, rangeHigh, firstAt, lastAt, n, firstSid, lastSid, n > 0 ? lastAt - firstAt : na, time_close, state)

f_range_packet_confirmed(simple int expectedMs, simple bool intradayBasis) =>
    RangeSnapshot packet = f_range_packet_full(expectedMs, intradayBasis)
    packet[1]

