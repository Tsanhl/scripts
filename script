guideMaxPlans = input.int(5, "Maximum accepted guide plans per session", minval=1, maxval=20, group="6. Entry guides", display=display.none, tooltip="Counts accepted price guides, not trades. This indicator has no realised PnL, account-level daily-loss lock or broker-position reconciliation. Those require the separate strategy or an execution service.")
guideEntryAtr = input.float(0.10, "Limit cap/floor allowance: prior chart ATR", minval=0, maxval=0.5, step=0.01, group="6. Entry guides", display=display.none, tooltip="BUY LIMIT cap = min(signal close + allowance x prior ATR, EMA + no-chase x ATR), rounded down to a tick. SELL LIMIT floor is the symmetric max, rounded up. This is NOT a buy-stop/sell-stop breakout trigger; execution can differ or never occur.")
