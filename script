f_own_spread(ChartSnapshot q) =>
    na(q) or na(q.plusDI) or na(q.minusDI) ? na : q.plusDI + q.minusDI > 0 ? (q.plusDI - q.minusDI) / (q.plusDI + q.minusDI) : 0.0
f_own_data_ok(ChartSnapshot q) =>
    ownDmiPolicy == "Reference only" or (not na(f_own_spread(q)) and (ownDmiPolicy != "Require DI + ADX" or not na(q.adxValue)))
f_own_side_ok(int side, ChartSnapshot q) =>
    ownDmiPolicy == "Reference only" or (f_own_data_ok(q) and side * f_own_spread(q) > 0 and side * f_own_spread(q) >= ownDiSpreadMin and (ownDmiPolicy != "Require DI + ADX" or q.ownAdxQualified))
f_confirm_label() =>
    confirmationMode == "Cumulative MOM" ? "MOM" + str.tostring(momContextLen) : confirmationMode == "Off" ? "CONFIRM OFF" : "PREV BLOCK " + str.tostring(momLen)

// ── Closed-bar diagnostic masks: ALL blockers, not only first failure ───────
// 1 source/price; 2 MOM data/session; 4 MOM threshold/sign; 8 Delta data;
// 16 Delta threshold/sign; 32/64 own-DI data/sign (NOT reference Trend);
// 128 confirm data/session; 256 confirm sign; 512 previous-bar break;
// 1024 no-chase; 2048 native MOM clock; 4096 own EMA side; 8192 DeltaN.
f_gate_mask(int side, ChartSnapshot q, bool sourceOK, bool clockOK, bool previousPriceOK, float previousHi, float previousLo) =>
    int mask = 0
    bool priceOK = not na(q) and not na(q.price) and not na(q.lowValue) and not na(q.highValue) and q.lowValue <= q.price and q.highValue >= q.price
    if not sourceOK or not priceOK
        mask += 1
    if na(q) or na(q.momNorm)
        mask += 2
    else if side * q.momNorm <= 0 or side * q.momNorm < momAtrMin
        mask += 4
    if requireFlow
        if na(q) or na(q.deltaPct)
            mask += 8
        else if side * q.deltaPct <= 0 or side * q.deltaPct < deltaPctMin
            mask += 16
    // Own-TF policy only. Reference Trend remains completely independent.
    if ownDmiPolicy != "Reference only"
        if na(f_own_spread(q))
            mask += 32
        else if side * f_own_spread(q) <= 0 or side * f_own_spread(q) < ownDiSpreadMin
            mask += 64
    if ownDmiPolicy == "Require DI + ADX"
        if na(q) or na(q.adxValue)
            mask += 16384
        else if not q.ownAdxQualified
            mask += 32768
    if requireRollingFlow and (na(q) or na(q.changePct) or side * q.changePct <= 0)
        mask += 8192
    float v = f_confirm_value(q)
    if confirmationMode != "Off"
        if na(v)
            mask += 128
        else if side * v <= 0
            mask += 256
    if requirePriceBreak
        if not previousPriceOK or not priceOK or (side == 1 ? q.price <= previousHi : q.price >= previousLo)
            mask += 512
    if na(q) or na(q.emaDistance)
        mask += 1 * (mask % 2 == 0 ? 1 : 0)
    else if requireNoChase and side * q.emaDistance > maxEmaDistanceAtr
        mask += 1024
    if not clockOK
        mask += 2048
    if requireEMASide and not na(q) and not na(q.emaDistance) and side * q.emaDistance <= 0
        mask += 4096
    mask
f_has_bit(int mask, int bitValue) =>
    not na(mask) and int(math.floor(float(mask) / bitValue)) % 2 == 1
f_mask_text(int mask) =>
    string txt = ""
    txt += f_has_bit(mask, 1) ? "SOURCE/PRICE; " : ""
    txt += f_has_bit(mask, 2) ? "ENTRY MOM HISTORY/SESSION; " : ""
    txt += f_has_bit(mask, 4) ? "MOM SIGN/MAGNITUDE; " : ""
    txt += f_has_bit(mask, 8) ? "DELTA SOURCE; " : ""
    txt += f_has_bit(mask, 16) ? "DELTA SIGN/MAGNITUDE; " : ""
    txt += f_has_bit(mask, 32) ? "OWN DI DATA; " : ""
    txt += f_has_bit(mask, 64) ? "OWN DI DIRECTION; " : ""
    txt += f_has_bit(mask, 16384) ? "OWN ADX DATA; " : ""
    txt += f_has_bit(mask, 32768) ? "OWN ADX STRENGTH; " : ""
    txt += f_has_bit(mask, 128) ? f_confirm_label() + " HISTORY/SESSION; " : ""
    txt += f_has_bit(mask, 256) ? f_confirm_label() + " SIGN; " : ""
    txt += f_has_bit(mask, 512) ? "PREVIOUS-BAR BREAK; " : ""
    txt += f_has_bit(mask, 1024) ? "NO-CHASE; " : ""
    txt += f_has_bit(mask, 2048) ? "MOM CLOCK GAP; " : ""
    txt += f_has_bit(mask, 4096) ? "OWN EMA SIDE; " : ""
    txt += f_has_bit(mask, 8192) ? "DELTAN DATA/SIGN; " : ""
    na(mask) ? "WAIT FIRST CLOSE" : mask == 0 ? "QUALIFIED BEFORE REVERSAL / EPISODE" : txt
f_first_blocker(int mask) =>
    na(mask) ? "WARMUP" : f_has_bit(mask, 1) ? "DATA / EMA" : f_has_bit(mask, 2048) ? "CLOCK / SESSION" : f_has_bit(mask, 2) ? "MOM HISTORY" : f_has_bit(mask, 4) ? "MOM" + str.tostring(momLen) : f_has_bit(mask, 128) ? f_confirm_label() + " HISTORY" : f_has_bit(mask, 256) ? f_confirm_label() : f_has_bit(mask, 32) ? "DI DATA" : f_has_bit(mask, 64) ? "DI SIDE" : f_has_bit(mask, 16384) ? "ADX DATA" : f_has_bit(mask, 32768) ? "ADX" : f_has_bit(mask, 8) ? "DELTA DATA" : f_has_bit(mask, 16) ? "DELTA1" : f_has_bit(mask, 8192) ? "DELTA" + str.tostring(deltaContextBars) : f_has_bit(mask, 512) ? "BREAK" : f_has_bit(mask, 4096) ? "EMA SIDE" : f_has_bit(mask, 1024) ? "NO CHASE" : "PASS"
