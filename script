showChartTRRow = input.bool(true, "Show multi-bar closed RANGE", group="3. Structure", display=display.none, tooltip="Actual lowest low / highest high over N completed full-duration RANGE candles. Not a single chart candle, an expected future range, or Wilder True Range. This row ALWAYS uses closed data, even in Live preview.")
rangeTFMode = input.string("Auto: minimum 15m", "RANGE timeframe", options=["Auto: minimum 15m", "Chart TF", "Manual"], group="3. Structure", display=display.none, tooltip="Auto: charts below 15m use 15m; 15m and higher use the chart TF. Example: 5m -> 15m, 15m -> 15m, 1h -> 1h. This changes RANGE only. Manual TF below the chart is explicitly clamped to the chart TF; the row always labels the effective TF.")
manualRangeTF = input.timeframe("60", "Manual RANGE TF", options=["1", "3", "5", "15", "30", "60", "120", "240", "1D", "1W", "1M"], group="3. Structure", display=display.none)
rangeLookback = input.int(4, "RANGE lookback: completed source bars", minval=1, maxval=100, group="3. Structure", display=display.none, tooltip="Default 4: 15m x4 = 60 nominal traded minutes; 1h x4 = 4 nominal traded hours. These are N complete candles, NOT necessarily N contiguous wall-clock intervals. Session gaps and skipped partial candles are disclosed in the tooltip. Use 1 for a single source candle.")
rangeSessionMode = input.string("Across sessions", "RANGE session policy", options=["Across sessions", "Same session only"], group="3. Structure", display=display.none, tooltip="Across sessions retains the last N complete source bars, possibly including the previous trading session. Same session only resets intraday RANGE at the selected session's start. Insufficient history stays WARMUP; the script never widens prices artificially.")
showPivotRow = input.bool(true, "Show previous chart-bar P / S1-R1 row", group="3. Structure", display=display.none)
trRangeColor = input.color(color.rgb(40, 110, 220), "TR row color", group="3. Structure", display=display.none)

