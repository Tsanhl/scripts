// Pivot references are explicitly PREVIOUS CHART BAR, not hidden Daily values.
// They are references for the currently visible bar, not a decision filter.
bool pivotReady = not na(high[1]) and not na(low[1]) and not na(close[1]) and high[1] >= low[1] and time_close[1] <= time
float chartP = pivotReady ? (high[1] + low[1] + close[1]) / 3.0 : na
float chartR1 = pivotReady ? 2.0 * chartP - low[1] : na
float chartS1 = pivotReady ? 2.0 * chartP - high[1] : na
// Pivot prices are table-only. No line or price-scale tag.

// BEGIN PIVOT CHANGE
// Current row P uses source bar [1]; the previous row P uses source bar [2].
// Both are closed, native-price chart bars. None of the current OHLC is used.
f_pivot_change(bool comparable, float currentP, float previousP, float tick) =>
    float result = na
    if comparable and not na(currentP) and not na(previousP) and not na(tick) and tick > 0
        // Remove arithmetic noise only; a real fractional-tick shift is retained.
        float epsilon = math.max(tick * 1e-8, math.max(math.abs(currentP), math.abs(previousP)) * 1e-12)
        float change = currentP - previousP
        result := math.abs(change) <= epsilon ? 0.0 : change
    result
f_pivot_change_text(float change, float tick) =>
    string pivotChangeLabel = "ΔP N/A"
    if not na(change) and not na(tick) and tick > 0
        int decimals = int(math.min(8, math.max(2, math.ceil(-math.log10(tick)))))
        float unit = math.pow(10.0, -decimals)
        float magnitude = math.round(math.abs(change), decimals)
        string amount = change != 0 and magnitude == 0 ? "<" + str.tostring(unit, "0.00######") : str.tostring(magnitude, "0.00######")
        pivotChangeLabel := (change > 0 ? "↑ " : change < 0 ? "↓ " : "→ ") + amount + " pts"
    pivotChangeLabel
float previousChartP = chartP[1]
bool pivotPairReady = pivotReady and pivotReady[1] and nativePriceOK[1] and nativePriceOK[2] and not na(previousChartP)
// Intraday comparisons restart after a session boundary; never bridge missing bars.
// Daily comparisons use successive observed daily bars, allowing weekends/holidays.
bool pivotPairSameSession = not chartIntraday or (time_tradingday == time_tradingday[1] and time_tradingday[1] == time_tradingday[2])
bool pivotPairContinuous = not chartIntraday or (time == time_close[1] and time[1] == time_close[2])
bool pivotPairComparable = chartSupported and pivotPairReady and pivotPairSameSession and pivotPairContinuous
float chartPChange = f_pivot_change(pivotPairComparable, chartP, previousChartP, syminfo.mintick)
string pivotChangeText = f_pivot_change_text(chartPChange, syminfo.mintick)
string pivotChangeState = not chartSupported ? "UNSUPPORTED CHART" : not pivotPairReady ? "NEED TWO VALID CLOSED SOURCE BARS" : not pivotPairSameSession ? "SESSION RESET" : not pivotPairContinuous ? "BAR GAP" : "OK"
// END PIVOT CHANGE

bool staleFeed = barstate.isrealtime and not na(feedEnd) and timenow - feedEnd > 90000
string sourceState = not chartSupported ? "CONTEXT ONLY | USE 1m-1D" : session.islastbar and barstate.isconfirmed ? "SESSION CLOSED" : staleFeed ? "DELAYED / STALE" : barstate.isrealtime ? "UPDATING" : "HISTORICAL / CLOSED"
sourceState += " | " + qualificationStatus + " | HISTORY=" + nativeHistoryState + " | " + snapshotStamp
sourceState += liveAlerts ? " | NOTIFICATIONS ENABLED" : " | ALERT CALLS OFF"
string trendText = na(shownTrend) ? "WAIT | " + trendTFText + " WARMUP" : f_trend_text(displayedTrendRegime, shownTrend.adxValue, shownTrend.spread, shownTrend.emaValue - shownTrend.previousEma, trendTF, displayedTrendStatus) + " @ " + f_time(shownTrend.endAt)
string ruleText = "OWN-TF: |MOM3/prior ATR| >= " + f_num(momAtrMin) + "; confirmation=" + confirmationMode + "; own DI/ADX=" + ownDmiPolicy + "; flow=" + flowPolicy + "; previous-bar close break=" + str.tostring(requirePriceBreak) + "; own EMA side=" + str.tostring(requireEMASide) + "; no-chase role=" + noChasePolicy + "; distance=" + f_num(maxEmaDistanceAtr) + " ATR; reverse=" + str.tostring(reversalConfirmBars) + " bars. Overall Trend REFERENCE ONLY. "
string entryBasisTip = "ACTIVE ENTRY BASIS=" + entryBasis + ". Gap-neutral MOM preserves the full chart-bar count and subtracts each observed opening gap open-close[1]. Previous-session intraday movement remains in a cross-session window. The gap-neutral EMA is translated back into current price units. Prior native ATR is retained. The default MOM display uses this same basis; NATIVE is an optional display comparison. Overall Trend is reference-only and flow policy is universal: " + flowPolicy + ". This basis has not been validated as a return optimum."
string sharedTip = "Except for the separately labelled Trend and RANGE, analytical calculations use the selected " + chartTFText + " chart. Evidence=" + snapshotStamp + ". Session=" + chartSessionName + ". ENTRY MOM / Delta policy=" + momentumSessionMode + ". " + ruleText + durationTip + " Table = last script snapshot, NOT the candle under the cursor. Use Data Window or Bar Replay for a historical candle. "
string trendTip = "REFERENCE ONLY. No effect on L/S qualification, reference invalidation or manual exit. " + trendText + ". Closed source timestamps checked before display. " + sharedTip
string momTip = "MOM basis=" + momDisplayBasis + "; active ENTRY basis=" + entryBasis + ". Active entry basis shows the exact MOM3/MOM6 used by the decision, including the same clock/session eligibility. G means gap-neutral chart price: full requested 3/6-bar history minus observed opening gaps, not shortened lookbacks. Native price comparison is display-only and uses unadjusted chart closes; XSESSION then marks an earlier-session reference. MOM3=P-P[3]; MOM6=P-P[6]; previous block=P[3]-P[6] at default length. Colour=" + momColorMode + "; arrows compare consecutive readings on the DISPLAYED basis, not trade permission. Missing values remain N/A. ENTRY evidence @ " + f_time(na(closed) ? na : closed.endAt) + "; ENTRY reason=" + actionReason + ". " + sharedTip
string flowTip = "Estimated signed VOLUME from native 1m OHLCV of " + flowTicker + ", aggregated to the selected chart's ACTUAL candle interval. Not actual bid/ask aggressor volume, capital inflow or options delta. Method=" + flowEstimator + ". Range-weighted: 1m V*(C-O)/(H-L), bounded by +/-V; zero range uses resolved price polarity. Delta1 = sum within ONE native chart candle. DeltaN = sum of the last N eligible native chart candles, default N=3. Percentages divide by the total source volume in the SAME window, not the average of bar percentages. A shortened but fully covered native candle is valid for DISPLAY and Delta context; it cannot originate a new full-TF entry. Context only never gates signals on volume. Require Delta1 enforces its sign and magnitude; Require Delta1 + DeltaN also enforces rolling sign. This policy is identical for EVERY symbol. DeltaN includes Delta1 and is NOT an independent vote. Missing volume/minutes stay N/A; no proxy, chart-volume fallback or synthetic minutes are used. Session CVD is hidden. B/M/K are volume units, not USD. " + "VENDOR ESTIMATE: a parent-chart volume number does not certify usable minute-level volume or exchange aggressor flow. " + (shownOK ? "Delta1 state=" + shown.deltaState + "; DeltaN state=" + shown.changeState + "; source-end=" + f_time(shown.sourceEnd) + "; chart-end=" + f_time(shown.endAt) + "; source-window volume=" + f_vol(shown.sourceVolume) + "; parent-chart volume=" + f_vol(shown.chartVolume) + "; DeltaN actual candle-duration sum=" + f_num(shown.deltaWindowMinutes) + " minutes. These volume feeds are not automatically assumed equal. " : "No snapshot. ") + sharedTip
string pivotTip = "P=(H+L+C)/3; R1=2P-L; S1=2P-H, from the PREVIOUS completed " + chartTFText + " CHART bar ending " + f_time(time_close[1]) + ". Not Daily unless chart=1D. Arrow/points compare this P with the preceding P: HLC3[1] - HLC3[2], NOT last price minus P and NOT volume Delta. Current P=" + str.tostring(chartP, "0.00######") + "; previous P=" + str.tostring(previousChartP, "0.00######") + " from source ending " + f_time(time_close[2]) + "; change=" + (na(chartPChange) ? "N/A" : str.tostring(chartPChange, "0.00######")) + " points; comparison=" + pivotChangeState + ". The arrow and unrounded difference are derived from closed source bars only; arithmetic noise is treated as zero. Normal display uses at least 2 and up to 8 decimals, according to the symbol tick precision. A nonzero move too small to print is shown with < rather than an arrow beside 0.00. Intraday session boundaries/missing bars withhold the comparison, not the existing levels. This is a local pivot shift, NOT a trend forecast, new alert, entry or decision gate."

// Defaults: 11 rows. Safety status is embedded in Entry, not removed.
string chartCaption = f_tf_caption(signalTF)
string trendCaption = f_tf_caption(trendTF)
string analysisCaption = chartCaption + actualDurationTag + (evidenceState == "LIVE PREVIEW" ? " LIVE" : "")
string entryZoneCaption = zone == "America/New_York" ? "ET" : zone == "Europe/London" ? "UK" : zone
int usedRows = 4 + (showCombinedExitRow ? 1 : 0) + (showSecondMOM ? 1 : 0) + (showFlow ? 1 : 0) + (showEMArow ? 1 : 0) + (showChartTRRow ? 1 : 0) + (showPivotRow ? 1 : 0) + (showRVOLrow ? 1 : 0)
var table panel = table.new(panelPosition, 2, usedRows, bgcolor=chart.bg_color, frame_color=color.new(chart.fg_color,65), frame_width=1, force_overlay=true)
if barstate.islast
    if showTable
        int row = 0
        f_row(panel, row, "Trend (" + trendCaption + ")", f_bias(displayedTrendRegime), f_color(displayedTrendRegime), trendTip + " Source=" + sourceState)
        row += 1
        string entryTitle = "Entry (" + chartCaption + ")"
        string entryTimeTip = "Last closed evidence: " + (not na(auditClosedAt) ? str.format_time(auditClosedAt, "yyyy-MM-dd HH:mm", zone) + " " + entryZoneCaption : "NO CLOSED EVIDENCE") + ". "
        f_row(panel, row, entryTitle, compactEntryText, compactEntryColor, entryTimeTip + entryGuideTip + sharedTip + " Full reason=" + actionReason + ". Source=" + sourceState + ". " + nativeHistoryState + ". " + entryBasisTip + " Break=" + (closedBreakSide == 1 ? "UP" : closedBreakSide == -1 ? "DOWN" : "NONE") + (requirePriceBreak ? " [FILTER]" : " [REF]"))
        table.cell_set_bgcolor(panel, 1, row, color.new(compactEntryColor, 88))
        row += 1
        if showCombinedExitRow
            f_row(panel, row, combinedExitTitle, combinedExitText, combinedExitColor, exitGuideTip + " Source=" + sourceState)
            row += 1
        f_row(panel, row, "DMI/ADX (" + analysisCaption + ")", shownOK ? f_adx_strength(shown.adxValue, shownAdxChange, shown.plusDI, shown.minusDI, shownSpread) : "WARMUP", f_move_color(shownSpread), "Own-TF policy=" + ownDmiPolicy + ". The selected mode uses only this chart TF; Overall Trend is independent. ΔDI=(+DI - -DI)/(+DI + -DI), NOT +DI itself and not a probability. ADX arrow is ADX change, not price direction. " + (shownOK ? "+DI=" + f_num(shown.plusDI) + "; -DI=" + f_num(shown.minusDI) + "; ADX=" + f_num(shown.adxValue) + ". " : "") + sharedTip)
        row += 1
        f_row(panel, row, "MOM" + str.tostring(momLen) + " " + momTFText, momMText + " | /ATR " + f_ratio(shownMomNorm) + momMTag, momColor, momTip)
        row += 1
        if showSecondMOM
            f_row(panel, row, "MOM" + str.tostring(momContextLen) + " " + momTFText, mom2MText + (confirmationMode == "Previous block (baseline)" ? " | PREV BLOCK " + f_mom(shownPriorMom) : "") + mom2MTag, cumulativeColor, momTip + " Active ENTRY confirmation=" + confirmationMode)
            row += 1
        if showFlow
            string d1 = "Δ1: " + (shownOK and not na(shown.delta1) and not na(shown.deltaPct) ? f_vol(shown.delta1) + " (" + f_percent(shown.deltaPct) + ")" : "N/A [" + (shownOK ? f_short_status(shown.deltaState) : "WARMUP") + "]")
            string dn = " | Δ" + str.tostring(deltaContextBars) + ": " + (shownOK and not na(shown.deltaN) and not na(shown.changePct) ? f_vol(shown.deltaN) + " (" + f_percent(shown.changePct) + ")" : "N/A [" + (shownOK ? f_short_status(shown.changeState) : "WARMUP") + "]")
            string deltaLabel = "Est Δ (" + analysisCaption + ")"
            f_row(panel, row, deltaLabel, d1 + dn, chart.fg_color, flowTip)
            row += 1
        if showEMArow
            string pos = shownOK and not na(shownEMA) ? f_price(shownEMA) + " | " + (shown.price > shownEMA ? "ABOVE" : shown.price < shownEMA ? "BELOW" : "AT") + " | " + f_ratio(shown.emaDistance) + " ATR" : "WARMUP"
            bool extended = shownOK and not na(shown.emaDistance) and math.abs(shown.emaDistance) > maxEmaDistanceAtr
            pos += extended ? " | NO CHASE" : ""
            f_row(panel, row, "EMA" + str.tostring(emaLen) + " (" + analysisCaption + ")" + (useGapEMA ? " [G]" : ""), pos, extended ? color.orange : emaColor, "Own EMA side is required when enabled. No-chase role=" + noChasePolicy + "; Warning only is not an entry approval. The new-entry reference gate also refuses an extended current price; L/S labels remain unchanged. Above/below compares the snapshot close, not a later live quote. " + (shownOK ? "Snapshot price=" + f_price(shown.price) + "; EMA=" + f_price(shown.emaValue) + "; prior ATR14=" + f_price(shown.atrValue) + "; distance=(snapshot close-EMA)/prior ATR. " : "") + sharedTip)
            row += 1
        if showChartTRRow
            string rangeText = rangeShownReady ? f_price(shownRange.lowValue) + " - " + f_price(shownRange.highValue) + " | " + f_price(shownRange.highValue - shownRange.lowValue) + " pts" + (rangeOlderBar ? " REF" : "") : rangeInvalidSource ? "N/A | SOURCE CHECK" : "WARMUP " + str.tostring(rangeSessionOK ? shownRange.count : 0) + "/" + str.tostring(rangeLookback)
            f_row(panel, row, rangeLabel, rangeText, rangeInvalidSource or rangeOlderBar ? color.orange : trRangeColor, rangeTip)
            row += 1
        if showPivotRow
            f_row(panel, row, (compactLabels ? "PIVOT " : "PIVOT PREV ") + chartTFText + (compactLabels ? "" : " REF"), "P " + f_price(chartP) + " | " + pivotChangeText + " | S1/R1 " + f_price(chartS1) + "/" + f_price(chartR1), pivotPColor, pivotTip)
            row += 1
        if showRVOLrow
            string rvText = shownOK and not na(shown.rvolValue) ? f_num(shown.rvolValue) + "x | n=" + str.tostring(shown.rvolSamples) : "N/A [" + (shownOK ? f_short_status(shown.rvolState) : "WARMUP") + "]"
            f_row(panel, row, "RVOL " + (rvolMode == "Chart bar" ? analyticTFText : "SESSION") + " EST", rvText, chart.fg_color, "Source=1m volume. Ratio=current actual window volume / MEDIAN of eligible prior matching session-offset windows; not a moving average of adjacent chart candles. A shortened 10m tail compares the same 10m window, not a full 15m. An observed session start and exact observed minute counts are required. Live estimates are provisional. Session mode remains cumulative. Not an entry filter. State=" + (shownOK ? shown.rvolState : "NO SNAPSHOT") + ". " + sharedTip)
            row += 1
        if row != usedRows
            runtime.error("Internal dashboard row allocation mismatch.")
    else
        table.clear(panel, 0, 0, 1, usedRows-1)

