// Loaded-chart history only, bounded to 400 records. Outcomes from the CURRENT
// forecast cannot enter its frozen source-time statistics. Counts are NOT odds.
f_forecast_history(array<ForecastResult> records, int key) =>
    int n = 0
    int hits = 0
    int opposed = 0
    int unknown = 0
    int shocks = 0
    int missing = 0
    array<int> sessions = array.new<int>(0)
    if array.size(records) > 0
        for j = 0 to array.size(records) - 1
            ForecastResult r = array.get(records, j)
            if r.key == key
                if r.censored
                    missing += 1
                else
                    n += 1
                    hits += r.outcome == 1 ? 1 : 0
                    opposed += r.outcome == -1 ? 1 : 0
                    unknown += r.outcome == 2 ? 1 : 0
                    shocks += r.shockSeen ? 1 : 0
                    if not array.includes(sessions, r.sessionId)
                        array.push(sessions, r.sessionId)
    "Prior same-side/same-rule forecasts: n=" + str.tostring(n) + "; watched 1ATR first=" + str.tostring(hits) + "; opposite first=" + str.tostring(opposed) + "; neither=" + str.tostring(n - hits - opposed - unknown) + "; order unknown=" + str.tostring(unknown) + "; future same-side shocks=" + str.tostring(shocks) + "; distinct sessions=" + str.tostring(array.size(sessions)) + "; censored=" + str.tostring(missing) + ". Descriptive counts, NOT a calibrated probability, independent trades or profitable edge. Current forecast excluded."
