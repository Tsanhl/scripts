// Signed code: +/-1 rollover forecast; +/-2 rejection forecast; +/-3 observed shock.
// Side is the hypothesized MARKET move, not your position or a new trade direction.
f_advisory_code(bool known, bool rolloverEnabled, bool flowKnown, float o, float h, float l, float c, float prevC, float prevEMA, float m, float prevM, float m2, float prevM2, float priorATR, float di, float prevDI, float d1, float dn) =>
    int code = 0
    bool numericOK = not na(o) and not na(h) and not na(l) and not na(c) and not na(prevC) and not na(prevEMA) and not na(m) and not na(prevM) and not na(m2) and not na(prevM2) and not na(priorATR)
    bool pricesOK = numericOK and h >= math.max(o, c) and l <= math.min(o, c) and h >= l
    if known and pricesOK and priorATR > 0
        float span = h - l
        float fadeBand = 0.02 * priorATR
        bool upWeak = prevC > prevEMA and c < o and c < prevC and m - prevM < -fadeBand and m2 - prevM2 < -fadeBand
        bool downWeak = prevC < prevEMA and c > o and c > prevC and m - prevM > fadeBand and m2 - prevM2 > fadeBand
        // Round ratios only at exact mathematical wick boundaries, never the Delta gate.
        bool highReject = upWeak and span > 0 and math.round((h - math.max(o, c)) / span, 10) >= 0.50 and math.round((c - l) / span, 10) <= 0.25
        bool lowReject = downWeak and span > 0 and math.round((math.min(o, c) - l) / span, 10) >= 0.50 and math.round((h - c) / span, 10) <= 0.25
        bool diKnown = not na(di) and not na(prevDI)
        bool rollDown = rolloverEnabled and upWeak and diKnown and math.round(di - prevDI, 10) <= -0.02 and flowKnown and not na(d1) and not na(dn) and d1 <= -0.08 and dn < 0
        bool rollUp = rolloverEnabled and downWeak and diKnown and math.round(di - prevDI, 10) >= 0.02 and flowKnown and not na(d1) and not na(dn) and d1 >= 0.08 and dn > 0
        bool downShock = span >= 2.0 * priorATR and o - c >= priorATR
        bool upShock = span >= 2.0 * priorATR and c - o >= priorATR
        // An already-observed shock NEVER opens a forecast about that same candle.
        code := downShock ? -3 : upShock ? 3 : highReject ? -2 : lowReject ? 2 : rollDown ? -1 : rollUp ? 1 : 0
    code
f_advisory_text(int code) =>
    code == -3 ? "DOWN SHOCK" : code == 3 ? "UP SHOCK" : code < 0 ? "DOWN WATCH" : code > 0 ? "UP WATCH" : ""
f_forecast_pattern(int code) =>
    math.abs(code) == 2 ? "REJECTION" : math.abs(code) == 1 ? "ROLLOVER" : "NONE"
f_forecast_key(int code) =>
    (math.abs(code) == 2 ? 0 : 2) + (code > 0 ? 1 : 0)
f_forecast_step(int side, float anchor, float distance, float o, float h, float l) =>
    // 0=no touch yet; 1=forecast-side first; -1=opposite first; 2=order unknown.
    float target = anchor + side * distance
    float opposite = anchor - side * distance
    bool atTarget = side * (o - target) >= 0
    bool atOpposite = side * (o - opposite) <= 0
    bool targetHit = side == 1 ? h >= target : l <= target
    bool oppositeHit = side == 1 ? l <= opposite : h >= opposite
    atTarget ? 1 : atOpposite ? -1 : targetHit and oppositeHit ? 2 : targetHit ? 1 : oppositeHit ? -1 : 0
f_forecast_status(int outcome) =>
    outcome == 1 ? "WATCHED MOVE FIRST" : outcome == -1 ? "OPPOSITE MOVE FIRST" : outcome == 2 ? "ORDER UNKNOWN" : "NEITHER BARRIER"
f_advisory_entry(string baseText, bool visible, string suffix) =>
