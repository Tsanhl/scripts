plot(actionDirection, "Decision LONG=1 WAIT=0 SHORT=-1", display=display.data_window)
plot(shownOK ? shown.delta1 : na, "Shown estimated Delta1", display=display.data_window)
plot(shownOK ? shown.deltaPct : na, "Shown Delta1 / volume", display=display.data_window)
plot(shownOK ? shown.deltaN : na, "Shown estimated DeltaN (default Delta3)", display=display.data_window)
plot(shownOK ? shown.changePct : na, "Shown DeltaN / total window volume", display=display.data_window)
plot(shownOK ? shown.rvolValue : na, "Shown chart RVOL", display=display.data_window)
plot(shownATR, "Shown prior chart ATR normalizer", display=display.data_window)
plot(rangeShownReady ? shownRange.lowValue : na, "RANGE envelope low (labelled TF x N)", display=display.data_window)
plot(rangeShownReady ? shownRange.highValue : na, "RANGE envelope high (labelled TF x N)", display=display.data_window)
plot(na(closed) ? na : closed.price, "Decision closed chart price", display=display.data_window)
plot(shownActualMinutes, "Shown native candle ACTUAL minutes", display=display.data_window)
plot(na(closed) ? na : closed.deltaPct, "Decision closed Delta / volume", display=display.data_window)
plot(na(closed) ? na : closed.endAt, "Decision source close UNIX ms", display=display.data_window)
