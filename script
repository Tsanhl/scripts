plot(showGuideLevels ? visibleGuideStop : na, "Guide / manual fixed stop", color=color.red, linewidth=1, style=plot.style_linebr, force_overlay=true, display=display.pane + display.data_window)
plot(showGuideLevels ? visibleGuideTarget : na, "Guide / manual fixed target", color=color.teal, linewidth=1, style=plot.style_linebr, force_overlay=true, display=display.pane + display.data_window)
