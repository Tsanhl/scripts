dashboardMode = input.string("Closed snapshot", "Dashboard evidence", options=["Closed snapshot", "Live preview"], group="4. Display", display=display.none, tooltip="Default: analytical rows explain the last closed chart event. Live preview changes detail rows only; ENTRY and RANGE remain closed. RANGE has its own labelled timeframe/lookback. Hover rows for timestamps and data diagnostics.")
