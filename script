plot(guideCompactVisible ? guidePlanStop : na, "ENTRY frozen stop reference", display=display.data_window)
plot(guideCompactVisible ? guidePlanTarget : na, "ENTRY frozen target reference", display=display.data_window)
plot(guideCompactVisible ? guidePlanExpiry : na, "ENTRY guide expiry UNIX ms", display=display.data_window)
