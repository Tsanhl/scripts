autoSLTouchAlerts = input.bool(true, "Notify SL touch intrabar", group="5. Alerts", display=display.none, tooltip="Requires master alerts and fresh native minute-clock evidence. Use Any alert() function call. One immediate notification per reference per script run. Reloading/recreating alerts resets the local delivery ledger. No broker order or guaranteed stop fill.")
riskRecoveryAlerts = input.bool(true, "Synchronize delayed TP / exit state", group="5. Alerts", display=display.none, tooltip="Records risk events observed while this script is running live. On the next fresh close, sends STATE SYNC with the original event-bar time and current notification time, never an old entry command. Historical attachment does not arm events. Not a broker/delivery acknowledgement or durable cross-restart queue.")
