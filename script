manualFillPrice = input.float(0.0, "Actual average fill price", minval=0, group="7. Manual position", display=display.none)
manualStop = input.float(0.0, "Your fixed stop price (required)", minval=0, group="7. Manual position", display=display.none)
manualTarget = input.float(0.0, "Your fixed target price (required)", minval=0, group="7. Manual position", display=display.none, tooltip="Enter actual intended price levels, not a new signal's changing levels. Both stop and target in one candle means ordering is unknown, not a winning fill. A stop on a fully post-fill candle invalidates on received updates. The first partial fill candle uses only its closing price because its earlier high/low may predate your fill. Notifications are not protective orders.")

// ── 8. Automatic table-only signal references ──────────────────────────────
autoSignalRisk = input.bool(true, "Automatic signal SL / TP / Exit references", group="8. Signal SL / Exit", display=display.none, tooltip="One frozen reference per new L/S episode, anchored at the completed signal CLOSE, not a broker fill. Manual position inputs take precedence. Levels appear only in the table / Data Window. Universal symbol rules; no index proxy.")
