emaLineBasis = input.string("Active entry EMA", "EMA line basis", options=["Active entry EMA", "Native EMA"], group="4. Display", display=display.none, tooltip="Default line matches the active entry EMA, including the [G] gap-neutral basis. Native EMA is the conventional ta.ema(close, length), display-only. Length defaults to 20. The live endpoint can move; L/S still requires a close.")
